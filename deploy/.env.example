# مَدَد — متغيرات الخادم. انسخ هذا الملف إلى .env على الخادم وحده واملأه هناك.
# لا يُرفع .env إلى المستودع أبداً (.gitignore يمنعه). القيم هنا فارغة عمداً.

# ——— القاعدة ———
POSTGRES_USER=madad
POSTGRES_DB=madad
POSTGRES_PASSWORD=

# ——— الخلفية ———
MADAD_ENV=production
MADAD_JWT_SECRET=                 # 48 حرفاً عشوائياً على الأقل: openssl rand -base64 48
MADAD_AUTH_CITY=TIP
MADAD_OTP_SENDER=channels
MADAD_MEDIA_DIR=/data/media
MADAD_BACKUP_DIR=/data/backups

# ——— رموز التحقق (م-24): كل قناة تعمل حين تُملأ متغيراتها، وتُرتَّب وتُفعَّل من اللوحة ———
# واتساب الرسمي — إما Meta Cloud API:
MADAD_OTP_WHATSAPP_OFFICIAL_PROVIDER=          # meta | twilio
MADAD_OTP_WHATSAPP_OFFICIAL_TOKEN=
MADAD_OTP_WHATSAPP_OFFICIAL_PHONE_NUMBER_ID=
MADAD_OTP_WHATSAPP_OFFICIAL_TEMPLATE=
# … أو Twilio:
MADAD_OTP_WHATSAPP_OFFICIAL_SID=
MADAD_OTP_WHATSAPP_OFFICIAL_SENDER=
MADAD_OTP_WHATSAPP_OFFICIAL_CONTENT_SID=
# واتساب برقم عادي عبر بوابة (خدمة منفصلة لم تُبنَ بعد):
MADAD_OTP_WHATSAPP_LINKED_PROVIDER=            # gateway
MADAD_OTP_WHATSAPP_LINKED_URL=
MADAD_OTP_WHATSAPP_LINKED_TOKEN=
# رسائل SMS عبر مزوّد ليبي بواجهة HTTP:
MADAD_OTP_SMS_PROVIDER=                        # http
MADAD_OTP_SMS_URL=
MADAD_OTP_SMS_AUTH_HEADER=
MADAD_OTP_SMS_AUTH_VALUE=
MADAD_OTP_SMS_SENDER=
MADAD_OTP_SMS_TO_FIELD=to
MADAD_OTP_SMS_TEXT_FIELD=text
MADAD_OTP_SMS_SENDER_FIELD=sender

# ——— الخرائط والإشعار الفوري ———
VITE_MAPBOX_TOKEN=                # رمز Mapbox العام (pk.) مقيَّد بنطاقات madad.tajora.ly — يُبنى في الواجهات
MADAD_MAPBOX_TOKEN=               # رمز Mapbox للخادم (طول المسار والموعد، ن-5): رمز ثانٍ غير مقيَّد بالنطاقات. فارغ = إدخال يدوي
MADAD_FCM_SERVICE_ACCOUNT_FILE=/run/secrets/fcm.json   # ملف حساب خدمة Firebase على الخادم، لا في المستودع

# ——— النسخ الاحتياطية (ن-3): المساحة المنفصلة (S3-متوافقة) ———
# كلمة سر التشفير لا توضع هنا: في ملف .env.backup وحده بسطر واحد MADAD_BACKUP_PASSPHRASE=… (دليل النشر، البند ٥).
MADAD_BACKUP_HOUR=3               # ساعة النسخة اليومية بتوقيت طرابلس
MADAD_BACKUP_S3_ENDPOINT=         # R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com · B2: https://s3.eu-central-003.backblazeb2.com
MADAD_BACKUP_S3_REGION=auto       # R2: auto · B2: eu-central-003
MADAD_BACKUP_S3_BUCKET=
MADAD_BACKUP_S3_ACCESS_KEY=
MADAD_BACKUP_S3_SECRET_KEY=

# ——— نفق Cloudflare (إن اختير) ———
CLOUDFLARE_TUNNEL_TOKEN=
